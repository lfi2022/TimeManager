{
  "name": "tempopoint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @lfinfo/shared build && pnpm --parallel --filter @lfinfo/backend --filter @lfinfo/frontend dev",
    "build": "pnpm --filter @lfinfo/shared build && pnpm --filter @lfinfo/backend build && pnpm --filter @lfinfo/frontend build",
    "start": "node backend/dist/server.js",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @lfinfo/shared build && pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 delete tempopoint",
    "test:dev": "playwright test -c playwright.dev.config.ts",
    "test:pm2": "pnpm build && node tests/smoke/pm2.mjs",
    "db:generate": "pnpm --filter @lfinfo/backend prisma:generate",
    "db:migrate": "pnpm --filter @lfinfo/backend prisma:migrate:deploy",
    "db:seed": "pnpm --filter @lfinfo/backend prisma:seed",
    "test:integration": "node scripts/run-integration-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@prisma/client": "6.19.3",
    "@types/node": "^24.10.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.12.0",
    "pm2": "^7.0.4",
    "prettier": "^3.7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  }
}
