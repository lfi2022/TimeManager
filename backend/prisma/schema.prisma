generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TimeBalanceType {
  OVERTIME
  RECOVERY
  MANUAL_ADJUSTMENT
  CORRECTION
  OPENING_BALANCE
}

enum WorkEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LOCKED
}

enum WorkEntrySource {
  MANUAL
  CLOCK
  OFFLINE_SYNC
  MANAGER
  IMPORT
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
}

enum CompanyRole {
  ADMIN
  MANAGER
  WORKER
}

model Company {
  id                  String                   @id @default(uuid()) @db.Uuid
  name                String
  slug                String                   @unique
  active              Boolean                  @default(true)
  timezone            String
  locale              String
  logoUrl             String?
  primaryColor        String?
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(6)
  users               User[]
  userSessions        UserSession[]
  passwordResetTokens UserPasswordResetToken[]
  teams               Team[]
  auditEvents         AuditEvent[]
  periodLocks         PeriodLock[]
  subscription        Subscription?
  worksites           Worksite[]
  workEntries WorkEntry[]
  balanceTransactions TimeBalanceTransaction[]
  notifications       Notification[]
  domains             CompanyDomain[]
  schedules           Schedule[]
  scheduleDays        ScheduleDay[]
  scheduleAssignments UserScheduleAssignment[]

  @@map("Company")
}

model PlatformUser {
  id                  String                      @id @default(uuid()) @db.Uuid
  email               String                      @unique
  passwordHash        String
  active              Boolean                     @default(true)
  createdAt           DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(6)
  lastLoginAt         DateTime?                   @db.Timestamptz(6)
  sessions            PlatformSession[]
  passwordResetTokens PlatformPasswordResetToken[]
  auditEvents         AuditEvent[]

  @@map("PlatformUser")
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  companyId           String                   @db.Uuid
  email               String
  passwordHash        String
  firstName           String
  lastName            String
  role                CompanyRole
  active              Boolean                  @default(true)
  employeeNumber      String?
  phone               String?
  timezone            String?
  locale              String?
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(6)
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions            UserSession[]
  passwordResetTokens UserPasswordResetToken[]
  teamMemberships     TeamMember[]
  auditEvents         AuditEvent[]
  lockedPeriodLocks   PeriodLock[]
  scheduleAssignments UserScheduleAssignment[]
  workEntries WorkEntry[] @relation("WorkEntryUser")
  balanceTransactions TimeBalanceTransaction[]
  notifications       Notification[]
  @@unique([companyId, email])
  @@index([companyId])
  @@map("User")
}

model UserSession {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique
  expiresAt     DateTime  @db.Timestamptz(6)
  invalidatedAt DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(6)
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  @@map("UserSession")
}

model PlatformSession {
  id             String       @id @default(uuid()) @db.Uuid
  platformUserId String       @db.Uuid
  tokenHash      String       @unique
  expiresAt      DateTime     @db.Timestamptz(6)
  invalidatedAt  DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  lastSeenAt     DateTime     @default(now()) @db.Timestamptz(6)
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("PlatformSession")
}

model UserPasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(6)
  usedAt      DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  @@map("UserPasswordResetToken")
}

model PlatformPasswordResetToken {
  id             String       @id @default(uuid()) @db.Uuid
  platformUserId String       @db.Uuid
  tokenHash      String       @unique
  expiresAt      DateTime     @db.Timestamptz(6)
  usedAt         DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("PlatformPasswordResetToken")
}

model Team {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  name        String
  description String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members     TeamMember[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("Team")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  isManager Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("TeamMember")
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @db.Uuid
  platformUserId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("AuditEvent")
}
model Worksite {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  code String?
  description String?
  address String?
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workEntries WorkEntry[]
  @@unique([companyId, name])
  @@index([companyId])
  @@map("Worksite")
}
model Schedule {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  name String
  weeklyMinutes Int?
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  days ScheduleDay[]
  assignments UserScheduleAssignment[]
  @@unique([companyId, name])
  @@index([companyId])
  @@map("Schedule")
}
model ScheduleDay {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  scheduleId String @db.Uuid
  dayOfWeek Int
  expectedMinutes Int
  defaultStartTime String?
  defaultEndTime String?
  defaultBreakMinutes Int?
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([scheduleId, dayOfWeek])
  @@index([companyId])
  @@map("ScheduleDay")
}
model UserScheduleAssignment {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  userId String @db.Uuid
  scheduleId String @db.Uuid
  validFrom DateTime @db.Date
  validUntil DateTime? @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  @@index([companyId, userId, validFrom])
  @@map("UserScheduleAssignment")
}
model WorkEntry {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 userId String @db.Uuid
 worksiteId String? @db.Uuid
  balanceTransactions TimeBalanceTransaction[]
 date DateTime @db.Date
 startTime DateTime? @db.Timestamptz(6)
 endTime DateTime? @db.Timestamptz(6)
 breakMinutes Int @default(0)
 workedMinutes Int
 expectedMinutes Int
 differenceMinutes Int
 status WorkEntryStatus @default(DRAFT)
 note String?
 source WorkEntrySource @default(MANUAL)
 createdByUserId String? @db.Uuid
 updatedByUserId String? @db.Uuid
 submittedAt DateTime? @db.Timestamptz(6)
 approvedAt DateTime? @db.Timestamptz(6)
 approvedByUserId String? @db.Uuid
 rejectedAt DateTime? @db.Timestamptz(6)
 rejectedByUserId String? @db.Uuid
 rejectionReason String?
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @db.Timestamptz(6)
 company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
 user User @relation("WorkEntryUser",fields:[userId],references:[id],onDelete:Cascade)
 worksite Worksite? @relation(fields:[worksiteId],references:[id],onDelete:SetNull)
 @@index([companyId,userId,date])
 @@map("WorkEntry")
}

model TimeBalanceTransaction {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 userId String @db.Uuid
 workEntryId String? @db.Uuid
 minutes Int
 type TimeBalanceType
 reason String?
 createdByUserId String? @db.Uuid
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 workEntry WorkEntry? @relation(fields:[workEntryId],references:[id],onDelete:SetNull)
 @@unique([workEntryId,type])
 @@index([companyId,userId,createdAt])
 @@map("TimeBalanceTransaction")
}
model ClockSession {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 userId String @db.Uuid
 worksiteId String? @db.Uuid
 startedAt DateTime @db.Timestamptz(6)
 stoppedAt DateTime? @db.Timestamptz(6)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 @@index([companyId,userId])
 @@map("ClockSession")
}
model PeriodLock {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  lockedAt       DateTime @default(now()) @db.Timestamptz(6)
  lockedByUserId String   @db.Uuid
  reason         String?
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lockedByUser   User     @relation(fields: [lockedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, startDate, endDate])
  @@map("PeriodLock")
}
model Plan {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  active Boolean @default(true)
  limits Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  subscriptions Subscription[]
  @@map("Plan")
}
model Subscription {
  id String @id @default(uuid()) @db.Uuid
  companyId String @unique @db.Uuid
  planId String @db.Uuid
  status SubscriptionStatus @default(ACTIVE)
  suspendedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  plan Plan @relation(fields:[planId],references:[id],onDelete:Restrict)
  @@index([planId])
  @@map("Subscription")
}
model Notification {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 userId String @db.Uuid
 type String
 title String
 body String
 readAt DateTime? @db.Timestamptz(6)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([companyId,userId,createdAt])
 @@map("Notification")
}

model CompanyDomain {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  hostname String @unique
  verificationToken String @unique
  verifiedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  @@index([companyId])
  @@map("CompanyDomain")
}